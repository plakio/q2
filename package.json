{
	"name": "q2",
	"version": "0.2.0",
	"private": true,
	"description": "A modern, self-hosted collaborative workspace for WordPress.",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=24",
		"npm": ">=11"
	},
	"scripts": {
		"build": "bash scripts/build.sh",
		"build:assets": "wp-scripts build",
		"release": "bash scripts/release.sh",
		"check": "npm run test:unit -- --runInBand && npm run lint:js && npm run lint:style && composer lint",
		"start": "wp-scripts start",
		"format": "wp-scripts format",
		"lint:js": "wp-scripts lint-js src",
		"lint:style": "wp-scripts lint-style 'src/**/*.scss'",
		"test:unit": "wp-scripts test-unit-js"
	},
	"devDependencies": {
		"@wordpress/scripts": "^34.1.0"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.53.0",
		"@wordpress/block-editor": "^16.2.0",
		"@wordpress/block-library": "^10.4.0",
		"@wordpress/blocks": "^15.26.0",
		"@wordpress/components": "^39.0.0",
		"@wordpress/editor": "^14.53.0",
		"@wordpress/element": "^8.5.0",
		"@wordpress/hooks": "^4.54.0",
		"@wordpress/i18n": "^6.26.0",
		"@wordpress/icons": "^15.4.0"
	}
}
