<?xml version="1.0"?>
<ruleset name="Q2">
	<description>Q2 WordPress coding standards.</description>
	<file>q2.php</file>
	<file>includes</file>
	<file>templates</file>
	<exclude-pattern>build/*</exclude-pattern>
	<rule ref="WordPress-Core">
		<!-- Q2 uses PSR-4 class paths rather than legacy class-*.php filenames. -->
		<exclude name="WordPress.Files.FileName" />
	</rule>
	<rule ref="WordPress-Docs" />
	<rule ref="WordPress-Extra" />
	<config name="text_domain" value="q2" />
	<arg name="extensions" value="php" />
</ruleset>
